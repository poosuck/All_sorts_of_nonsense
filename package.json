{
  "name": "byeoljit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/unit/*.test.js",
    "test:e2e": "playwright test",
    "source:sync": "node scripts/sync-pudding-source.mjs",
    "source:check": "node scripts/sync-pudding-source.mjs --check",
    "pigeon:build": "blender -b --factory-startup -t 2 --python-exit-code 1 --python scripts/pigeon-stage1/build.py",
    "pigeon:probe": "blender -b --factory-startup -t 2 --python-exit-code 1 --python scripts/pigeon-stage1/probe_tools.py",
    "pigeon:editor": "node scripts/build-pigeon-editor.mjs"
  },
  "dependencies": {
    "@lucide/vue": "1.31.0",
    "three": "0.186.0",
    "vue": "3.5.44",
    "vue-router": "4.6.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@vitejs/plugin-vue": "6.0.10",
    "postcss": "8.5.31",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
